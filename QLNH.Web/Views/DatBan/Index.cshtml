@model QLNH_Web.ViewModels.DatBanPageVM
@using QLNH_Web.Services
@{
    ViewData["Title"] = "Đặt bàn - Nhà hàng Hương Việt";
}

@Html.AntiForgeryToken()


<style>
    /* ── Hero ── */
    .db-hero {
        background: linear-gradient(135deg, #b3261e, #e8590c);
        color: #fff;
        border-radius: 1rem;
        padding: 2.5rem 2rem;
        margin-bottom: 2rem;
    }
    .db-hero h1 { font-size: 2rem; font-weight: 700; margin-bottom: .5rem; }
    .db-hero p  { opacity: .9; margin: 0; font-size: 1.05rem; }

    /* ── Step tabs ── */
    .db-steps {
        display: flex;
        gap: .5rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }
    .db-step {
        flex: 1;
        min-width: 140px;
        background: #fff;
        border: 2px solid #dee2e6;
        border-radius: .75rem;
        padding: .75rem 1rem;
        cursor: pointer;
        transition: border-color .2s, background .2s, color .2s;
        text-align: center;
        font-weight: 600;
        font-size: .88rem;
        color: #6c757d;
        line-height: 1.3;
    }
    .db-step small { display: block; font-size: .72rem; font-weight: 500; color: #adb5bd; margin-bottom: .2rem; }
    .db-step.active {
        border-color: #b3261e;
        background: #b3261e;
        color: #fff;
    }
    .db-step.active small { color: rgba(255,255,255,.8); }
    .db-step:disabled { cursor: default; }

    /* ── Cards ── */
    .db-card {
        background: #fff;
        border-radius: .875rem;
        border: 1px solid #e9ecef;
        border-top: 3px solid #b3261e;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        padding: 1.5rem;
        margin-bottom: 1.25rem;
    }
    .db-card h2 {
        font-size: 1.05rem;
        font-weight: 700;
        color: #212529;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }
    .db-card h2 svg { color: #b3261e; }
    .h2-note {
        font-size: .78rem;
        font-weight: 400;
        color: #6c757d;
        margin-left: .3rem;
    }

    /* ── Fields ── */
    .db-field { margin-bottom: 1rem; }
    .db-field label { font-size: .85rem; font-weight: 600; color: #495057; margin-bottom: .35rem; display: block; }
    .db-inp {
        position: relative;
        display: flex;
        align-items: center;
    }
    .db-inp svg { position: absolute; left: .75rem; width: 16px; height: 16px; color: #adb5bd; pointer-events: none; }
    .db-inp input, .db-inp select {
        padding-left: 2.25rem !important;
    }
    .db-inp input:not([type=date]):not([type=time]),
    .db-inp select {
        width: 100%;
    }
    .db-inp input[type=date] { width: 100%; }

    /* Bootstrap form-control overrides */
    .db-card .form-control, .db-card .form-select {
        border-radius: .5rem;
        border-color: #dee2e6;
    }
    .db-card .form-control:focus, .db-card .form-select:focus {
        border-color: #b3261e;
        box-shadow: 0 0 0 .2rem rgba(179,38,30,.15);
    }

    /* ── Grid helpers ── */
    .db-grid-2 { display: grid; grid-template-columns: repeat(auto-fit,minmax(200px,1fr)); gap: 1rem; }
    .db-grid-3 { display: grid; grid-template-columns: repeat(auto-fit,minmax(160px,1fr)); gap: 1rem; }

    /* ── Stepper (số khách) ── */
    .db-stepper {
        display: flex;
        align-items: center;
        gap: .5rem;
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: .5rem;
        padding: .4rem .75rem;
        width: fit-content;
        min-width: 140px;
    }
    .db-stepper button {
        background: none;
        border: none;
        color: #b3261e;
        font-size: 1.25rem;
        cursor: pointer;
        padding: 0 .3rem;
        line-height: 1;
    }
    .db-stepper b { flex: 1; text-align: center; font-weight: 700; font-size: .95rem; }

    /* ── Khu vực (area chips) ── */
    #areas { display: grid; grid-template-columns: repeat(auto-fill,minmax(180px,1fr)); gap: .75rem; }
    .area-card {
        border: 2px solid #dee2e6;
        border-radius: .75rem;
        padding: .85rem 1rem;
        cursor: pointer;
        transition: border-color .2s, background .2s;
        font-size: .88rem;
        font-weight: 500;
    }
    .area-card.selected { border-color: #b3261e; background: #fff5f5; }
    .area-card .area-name { font-weight: 700; color: #212529; }
    .area-card .area-desc { font-size: .78rem; color: #6c757d; margin-top: .15rem; }
    .area-card .area-fee { font-size: .8rem; color: #b3261e; font-weight: 600; margin-top: .2rem; }

    /* ── Category chips (menu filter) ── */
    .db-chips { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: 1rem; }
    .db-chip {
        background: #f1f3f5;
        border: 1.5px solid #dee2e6;
        border-radius: 99px;
        padding: .3rem .9rem;
        font-size: .82rem;
        font-weight: 600;
        cursor: pointer;
        transition: .15s;
        color: #495057;
    }
    .db-chip.active { background: #b3261e; border-color: #b3261e; color: #fff; }

    /* ── Menu item cards ── */
    #menu { display: grid; grid-template-columns: repeat(auto-fill,minmax(200px,1fr)); gap: .75rem; }
    .menu-item {
        border: 1.5px solid #e9ecef;
        border-radius: .75rem;
        overflow: hidden;
        cursor: pointer;
        transition: box-shadow .2s, border-color .2s;
        background: #fff;
    }
    .menu-item:hover { box-shadow: 0 4px 14px rgba(0,0,0,.1); border-color: #b3261e; }
    .menu-item img { width: 100%; height: 120px; object-fit: cover; }
    .menu-item-body { padding: .65rem .8rem; }
    .menu-item-name { font-weight: 700; font-size: .88rem; color: #212529; }
    .menu-item-price { color: #b3261e; font-weight: 700; font-size: .88rem; }
    .menu-qty {
        display: flex; align-items: center; gap: .3rem;
        margin-top: .35rem;
    }
    .menu-qty button {
        background: #b3261e; color: #fff;
        border: none; border-radius: .35rem;
        width: 24px; height: 24px;
        font-size: 1rem; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
    }
    .menu-qty span { font-weight: 700; min-width: 28px; text-align: center; font-size: .88rem; }

    /* ── Cart box ── */
    .db-cartbox {
        background: #fff9f9;
        border: 1.5px dashed #f28b82;
        border-radius: .75rem;
        padding: 1rem 1.25rem;
        margin-top: 1rem;
    }
    .db-cartbox h5 { font-size: .9rem; font-weight: 700; color: #b3261e; margin-bottom: .75rem; }
    .db-cart-row { display: flex; justify-content: space-between; align-items: center; font-size: .85rem; margin-bottom: .35rem; }
    .db-cart-total { font-weight: 700; color: #b3261e; border-top: 1px solid #f28b82; padding-top: .5rem; margin-top: .5rem; }

    /* ── Promo ── */
    .db-promo { display: flex; gap: .5rem; margin-bottom: 1rem; }
    .db-promo input { flex: 1; }

    /* ── Bill ── */
    .db-bill { font-size: .9rem; }
    .db-bill-row { display: flex; justify-content: space-between; padding: .3rem 0; border-bottom: 1px solid #f1f3f5; }
    .db-bill-row.total { font-weight: 700; font-size: 1rem; border-bottom: none; color: #b3261e; }

    /* ── Deposit modes ── */
    #modes { display: grid; grid-template-columns: repeat(auto-fill,minmax(160px,1fr)); gap: .75rem; }
    .mode-card {
        border: 2px solid #dee2e6;
        border-radius: .75rem;
        padding: .85rem 1rem;
        cursor: pointer;
        transition: .2s;
        text-align: center;
        font-size: .88rem;
    }
    .mode-card.selected { border-color: #b3261e; background: #fff5f5; }
    .mode-card .mode-amount { font-size: 1.1rem; font-weight: 800; color: #b3261e; }

    /* ── Payment methods ── */
    #methods { display: grid; grid-template-columns: repeat(auto-fill,minmax(130px,1fr)); gap: .75rem; margin-bottom: 1rem; }
    .pay-method {
        border: 2px solid #dee2e6;
        border-radius: .75rem;
        padding: .75rem .5rem;
        text-align: center;
        cursor: pointer;
        transition: .2s;
        font-size: .82rem;
        font-weight: 600;
        color: #495057;
    }
    .pay-method.selected { border-color: #b3261e; background: #fff5f5; color: #b3261e; }
    .pay-method svg { display: block; margin: 0 auto .4rem; }

    /* ── Note box ── */
    .db-note {
        background: #f8f9fa;
        border-left: 3px solid #b3261e;
        border-radius: 0 .5rem .5rem 0;
        padding: .6rem 1rem;
        font-size: .82rem;
        color: #6c757d;
        margin-top: .75rem;
    }

    /* ── Due amount ── */
    .db-due {
        background: linear-gradient(135deg,#b3261e,#e8590c);
        color: #fff;
        border-radius: .75rem;
        padding: 1rem 1.25rem;
        text-align: center;
        margin-top: 1rem;
        font-size: 1.5rem;
        font-weight: 800;
    }
    .db-due small { display: block; font-size: .8rem; font-weight: 400; opacity: .85; margin-top: .2rem; }

    /* ── Buttons ── */
    .btn-brand { background: #b3261e; color: #fff; border: none; border-radius: .6rem; padding: .7rem 2rem; font-weight: 700; font-size: .95rem; transition: .2s; }
    .btn-brand:hover { background: #922018; color: #fff; }
    .btn-ghost-brand { background: transparent; border: 2px solid #b3261e; color: #b3261e; border-radius: .6rem; padding: .65rem 1.5rem; font-weight: 700; font-size: .9rem; transition: .2s; }
    .btn-ghost-brand:hover { background: #b3261e; color: #fff; }

    /* ── Back link ── */
    .db-back { background: none; border: none; color: #b3261e; font-weight: 600; font-size: .9rem; cursor: pointer; padding: 0; margin-bottom: 1.25rem; }
    .db-back svg { vertical-align: middle; }

    /* ── Done / ticket ── */
    .db-done {
        text-align: center;
        padding: 2.5rem 1rem;
    }
    .db-done .done-icon { font-size: 3.5rem; margin-bottom: 1rem; }
    .db-done h3 { font-weight: 800; color: #b3261e; }

    /* ── Toast ── */
    #toast {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        background: #212529;
        color: #fff;
        padding: .7rem 1.25rem;
        border-radius: .6rem;
        font-size: .88rem;
        z-index: 9999;
        opacity: 0;
        transition: opacity .3s;
        pointer-events: none;
    }
    #toast.show { opacity: 1; }

    /* SVG icons */
    .ic { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    /* ── Alias: JS generates these class names (aura-datban.js) ── */
    /* .tab = step button được JS toggle */
    .tab { flex: 1; min-width: 140px; background: #fff; border: 2px solid #dee2e6; border-radius: .75rem; padding: .75rem 1rem; cursor: pointer; transition: border-color .2s, background .2s, color .2s; text-align: center; font-weight: 600; font-size: .88rem; color: #6c757d; line-height: 1.3; }
    .tab small { display: block; font-size: .72rem; font-weight: 500; color: #adb5bd; margin-bottom: .2rem; }
    .tab.active, .tab.done { border-color: #b3261e; background: #b3261e; color: #fff; }
    .tab.active small, .tab.done small { color: rgba(255,255,255,.8); }
    .tab.done { opacity: .7; }
    .tab:disabled { cursor: default; opacity: .5; }

    /* .area = khu vực card */
    .area { border: 2px solid #dee2e6; border-radius: .75rem; padding: .85rem 1rem; cursor: pointer; transition: border-color .2s, background .2s; font-size: .88rem; font-weight: 500; background: #fff; text-align: left; }
    .area:hover:not(.off) { border-color: #b3261e; }
    .area.sel { border-color: #b3261e; background: #fff5f5; }
    .area.off { opacity: .55; cursor: not-allowed; }
    .area-head { display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; margin-bottom: .3rem; }
    .area-head svg { color: #b3261e; flex-shrink: 0; }
    .area-head span:first-of-type { font-weight: 700; color: #212529; flex: 1; }
    .area .price { font-size: .8rem; font-weight: 700; color: #b3261e; }
    .area .free { color: #198754; }
    .area p { margin: 0; font-size: .78rem; color: #6c757d; }

    /* .chip = category filter */
    .chip { background: #f1f3f5; border: 1.5px solid #dee2e6; border-radius: 99px; padding: .3rem .9rem; font-size: .82rem; font-weight: 600; cursor: pointer; transition: .15s; color: #495057; }
    .chip.on, .chip.active { background: #b3261e; border-color: #b3261e; color: #fff; }

    /* .dish / .dish-img / .dish-body */
    .dish { border: 1.5px solid #e9ecef; border-radius: .75rem; overflow: hidden; background: #fff; transition: box-shadow .2s, border-color .2s; }
    .dish:hover { box-shadow: 0 4px 14px rgba(0,0,0,.1); border-color: #b3261e; }
    .dish-img img { width: 100%; height: 120px; object-fit: cover; }
    .dish-img .tile { width: 100%; height: 120px; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; background: #f8f9fa; }
    .dish-body { padding: .65rem .8rem; }
    .dish-name { font-weight: 700; font-size: .88rem; color: #212529; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .dish-desc { font-size: .74rem; color: #6c757d; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .dish-price { color: #b3261e; font-weight: 700; font-size: .88rem; margin-top: .2rem; }
    .btn-add { margin-top: .4rem; background: #b3261e; color: #fff; border: none; border-radius: .4rem; padding: .25rem .65rem; font-size: .8rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: .2rem; }
    .btn-add:hover { background: #922018; }
    .qstep { display: flex; align-items: center; gap: .3rem; margin-top: .35rem; }
    .qstep button { background: #b3261e; color: #fff; border: none; border-radius: .35rem; width: 24px; height: 24px; font-size: 1rem; cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .qstep b { font-weight: 700; min-width: 28px; text-align: center; font-size: .88rem; }

    /* .cart / cart-item */
    .cartbox { margin-top: 1rem; }
    .cart { background: #fff9f9; border: 1.5px dashed #f28b82; border-radius: .75rem; padding: 1rem 1.25rem; }
    .cart-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: .75rem; }
    .cart-title { font-size: .9rem; font-weight: 700; color: #b3261e; display: flex; align-items: center; gap: .35rem; }
    .cart-hint { font-size: .75rem; color: #6c757d; }
    .cart-item { display: flex; justify-content: space-between; align-items: center; font-size: .85rem; margin-bottom: .35rem; }
    .ci-l { flex: 1; }
    .ci-name { font-weight: 600; color: #212529; }
    .ci-sub { font-size: .78rem; color: #6c757d; }
    .ci-r { display: flex; align-items: center; gap: .5rem; }
    .ci-r b { font-weight: 700; color: #b3261e; }
    .ci-del { background: none; border: none; color: #adb5bd; cursor: pointer; padding: 0; line-height: 1; }
    .ci-del:hover { color: #dc3545; }
    .cart-total { display: flex; justify-content: space-between; font-weight: 700; color: #b3261e; border-top: 1px solid #f28b82; padding-top: .5rem; margin-top: .5rem; font-size: .9rem; }

    /* .bill-row, .bill-total */
    .bill-row { display: flex; justify-content: space-between; padding: .3rem 0; border-bottom: 1px solid #f1f3f5; font-size: .9rem; }
    .bill-row.main { font-weight: 600; }
    .bill-row.disc span:last-child { color: #198754; font-weight: 700; }
    .bill-total { display: flex; justify-content: space-between; font-weight: 800; font-size: 1.05rem; color: #b3261e; padding-top: .5rem; margin-top: .35rem; }

    /* .mode = deposit mode card */
    .mode { border: 2px solid #dee2e6; border-radius: .75rem; padding: .85rem 1rem; cursor: pointer; transition: .2s; background: #fff; text-align: left; }
    .mode small { display: block; font-size: .72rem; font-weight: 700; color: #6c757d; letter-spacing: .03em; text-transform: uppercase; margin-bottom: .25rem; }
    .mode b { display: block; font-size: 1.1rem; font-weight: 800; color: #b3261e; margin-bottom: .25rem; }
    .mode span { font-size: .78rem; color: #6c757d; }
    .mode.sel { border-color: #b3261e; background: #fff5f5; }
    .mode.off { opacity: .5; cursor: not-allowed; }

    /* #due */
    #due > div { display: flex; flex-wrap: wrap; gap: .75rem; background: linear-gradient(135deg,#b3261e,#e8590c); color: #fff; border-radius: .75rem; padding: 1rem 1.25rem; margin-top: .75rem; }
    .due-l { font-size: .85rem; opacity: .9; }
    .due-v { font-size: 1.5rem; font-weight: 800; }
    .due-r { display: flex; flex-direction: column; gap: .2rem; font-size: .85rem; opacity: .9; }
    .due-r b { font-size: 1rem; font-weight: 700; }

    /* .mtab = payment method tab */
    .mtab { border: 2px solid #dee2e6; border-radius: .75rem; padding: .75rem .5rem; text-align: center; cursor: pointer; transition: .2s; background: #fff; }
    .mtab b { display: block; font-size: .82rem; font-weight: 700; color: #212529; }
    .mtab small { display: block; font-size: .72rem; color: #6c757d; margin-top: .2rem; }
    .mtab.sel { border-color: #b3261e; background: #fff5f5; }
    .mtab.sel b { color: #b3261e; }

    /* payinfo / bchip / qrbox / pi-name / amber */
    .payinfo { margin-top: .75rem; }
    .bank-chips { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: .75rem; }
    .bchip { background: #f1f3f5; border: 1.5px solid #dee2e6; border-radius: 99px; padding: .3rem .9rem; font-size: .82rem; font-weight: 600; cursor: pointer; transition: .15s; color: #495057; }
    .bchip.on { background: #b3261e; border-color: #b3261e; color: #fff; }
    .qrbox { display: flex; justify-content: center; margin: .75rem 0; }
    .pi-name { font-weight: 700; font-size: 1rem; color: #212529; margin-bottom: .5rem; }
    .payinfo > div { display: flex; gap: .5rem; font-size: .88rem; padding: .2rem 0; }
    .amber { color: #e86c0c; }
    .green { color: #198754; }
    .strong { font-weight: 700; }

    /* done / vcard / sum-row */
    .done-ic { width: 64px; height: 64px; background: #b3261e; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; color: #fff; }
    .done-ic svg { width: 30px; height: 30px; }
    .pill-ok { background: #d1f5d3; color: #198754; border-radius: 99px; padding: .25rem .9rem; font-size: .8rem; font-weight: 700; }
    .done-title { font-size: 1.3rem; font-weight: 800; color: #212529; margin: .75rem 0 .35rem; }
    p.muted { font-size: .82rem; color: #6c757d; margin-bottom: 1rem; }
    .vcard { background: #f8f9fa; border: 1px solid #e9ecef; border-radius: .75rem; padding: 1.25rem; display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem; }
    .vcard dl { flex: 1; min-width: 200px; margin: 0; }
    .vcard dt { font-size: .8rem; color: #6c757d; margin-top: .5rem; }
    .vcard dd { font-weight: 600; color: #212529; margin: 0; }
    .vcard dd.code { font-size: 1.2rem; font-weight: 800; color: #b3261e; letter-spacing: .05em; }
    .vcard dd.amber { color: #e86c0c; }
    .vcard-qr { display: flex; flex-direction: column; align-items: center; gap: .3rem; }
    .vcard-qr small { font-size: .75rem; color: #6c757d; }
    .sum-row { display: flex; justify-content: space-between; padding: .3rem 0; font-size: .88rem; }
    h4.sub { font-weight: 700; color: #212529; margin: 1rem 0 .5rem; font-size: .95rem; }
    .actions.center { display: flex; justify-content: center; gap: .75rem; margin-top: 1rem; flex-wrap: wrap; }
    .btn-ghost { background: transparent; border: 2px solid #6c757d; color: #6c757d; border-radius: .6rem; padding: .6rem 1.25rem; font-weight: 600; font-size: .88rem; cursor: pointer; transition: .2s; display: inline-flex; align-items: center; gap: .35rem; }
    .btn-ghost:hover { background: #6c757d; color: #fff; }
    .btn-main { background: #b3261e; color: #fff; border: none; border-radius: .6rem; padding: .65rem 1.5rem; font-weight: 700; font-size: .9rem; cursor: pointer; transition: .2s; display: inline-flex; align-items: center; gap: .35rem; }
    .btn-main:hover { background: #922018; }
    .btn-gold { background: #e86c0c; color: #fff; border: none; border-radius: .6rem; padding: .65rem 1.25rem; font-weight: 700; cursor: pointer; }

    p.note { font-size: .8rem; color: #6c757d; background: #f8f9fa; border-left: 3px solid #b3261e; border-radius: 0 .5rem .5rem 0; padding: .5rem .9rem; margin-top: .5rem; }

    @@media print {
        .navbar, footer, .no-print, .db-steps { display: none !important; }
        .db-card { box-shadow: none !important; border: 1px solid #ccc !important; }
    }
</style>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="i-user"    viewBox="0 0 24 24"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></symbol>
    <symbol id="i-phone"   viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></symbol>
    <symbol id="i-mail"    viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></symbol>
    <symbol id="i-cal"     viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></symbol>
    <symbol id="i-pin"     viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></symbol>
    <symbol id="i-spark"   viewBox="0 0 24 24"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 17v4M17 19h4"/></symbol>
    <symbol id="i-plus"    viewBox="0 0 24 24"><path d="M5 12h14M12 5v14"/></symbol>
    <symbol id="i-minus"   viewBox="0 0 24 24"><path d="M5 12h14"/></symbol>
    <symbol id="i-next"    viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></symbol>
    <symbol id="i-tag"     viewBox="0 0 24 24"><path d="M12 2H2v10l9.29 9.29a1 1 0 0 0 1.41 0l8.59-8.59a1 1 0 0 0 0-1.41L12 2Z"/><path d="M7 7h.01"/></symbol>
    <symbol id="i-card"    viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></symbol>
    <symbol id="i-qr"      viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14v.01M14 20h.01M20 20h.01M17 17v4"/></symbol>
    <symbol id="i-check"   viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></symbol>
    <symbol id="i-left"    viewBox="0 0 24 24"><path d="m12 19-7-7 7-7M19 12H5"/></symbol>
    <symbol id="i-print"   viewBox="0 0 24 24"><path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></symbol>
    <symbol id="i-refresh" viewBox="0 0 24 24"><path d="M3 12a9 9 0 0 1 15-6.7L21 8M21 3v5h-5M21 12a9 9 0 0 1-15 6.7L3 16M3 21v-5h5"/></symbol>
    <symbol id="i-trash"   viewBox="0 0 24 24"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M10 11v6M14 11v6"/></symbol>
    <symbol id="i-bag"     viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></symbol>
    <symbol id="i-checkc"  viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></symbol>
    <symbol id="i-fork"    viewBox="0 0 24 24"><path d="M4 3v7a3 3 0 0 0 3 3v8M7 3v7M10 3v7a3 3 0 0 1-3 3M17 21V3c-2.5 1.5-4 4.5-4 8h4"/></symbol>
</svg>

<div class="db-hero">
    <h1>🍽️ Đặt bàn tại Hương Việt</h1>
    <p>Phiếu đặt bàn, chọn món trước &amp; đặt cọc trực tuyến — nhanh chóng, tiện lợi.</p>
</div>

<div class="db-steps" id="tabs">
    <button type="button" class="db-step tab active" data-step="1"><small>BƯỚC 1</small>Đặt Bàn &amp; Thực Đơn</button>
    <button type="button" class="db-step tab" data-step="2"><small>BƯỚC 2</small>Đặt Cọc &amp; Thanh Toán</button>
    <button type="button" class="db-step tab" data-step="3"><small>BƯỚC 3</small>Vé Check-In</button>
</div>

<div id="p1" class="panel">
    <form id="f1" autocomplete="off">
        <div class="db-card">
            <h2><svg class="ic"><use href="#i-user"/></svg> 1. Thông Tin Khách Hàng</h2>
            <div class="db-grid-2">
                <div class="db-field">
                    <label for="f-ten">Họ và tên *</label>
                    <div class="db-inp">
                        <svg class="ic"><use href="#i-user"/></svg>
                        <input id="f-ten" class="form-control" required maxlength="100" placeholder="Nguyễn Văn Ánh" />
                    </div>
                </div>
                <div class="db-field">
                    <label for="f-sdt">Số điện thoại *</label>
                    <div class="db-inp">
                        <svg class="ic"><use href="#i-phone"/></svg>
                        <input id="f-sdt" class="form-control" required inputmode="tel" pattern="(0|\+84)[0-9]{9}" title="VD: 0908123456" placeholder="0908123456" />
                    </div>
                </div>
            </div>
            <div class="db-field">
                <label for="f-email">Email (nhận vé đặt chỗ) *</label>
                <div class="db-inp">
                    <svg class="ic"><use href="#i-mail"/></svg>
                    <input id="f-email" class="form-control" type="email" required placeholder="anh.nguyen@example.com" />
                </div>
            </div>
        </div>

        <div class="db-card">
            <h2><svg class="ic"><use href="#i-cal"/></svg> 2. Thời Gian &amp; Chi Tiết Đặt Bàn</h2>
            <div class="db-grid-3">
                <div class="db-field">
                    <label for="f-ngay">Ngày dùng bữa *</label>
                    <div class="db-inp">
                        <input id="f-ngay" class="form-control" type="date" required />
                    </div>
                </div>
                <div class="db-field">
                    <label for="f-gio">Giờ hẹn *</label>
                    <div class="db-inp">
                        <select id="f-gio" class="form-select" required></select>
                    </div>
                </div>
                <div class="db-field">
                    <label>Số lượng khách *</label>
                    <div class="db-stepper">
                        <button type="button" id="g-minus" aria-label="Giảm"><svg class="ic"><use href="#i-minus"/></svg></button>
                        <b id="g-val">2 Khách</b>
                        <button type="button" id="g-plus"  aria-label="Tăng"><svg class="ic"><use href="#i-plus"/></svg></button>
                    </div>
                </div>
            </div>

            <div class="db-field">
                <label>Lựa chọn không gian / khu vực *</label>
                <div id="areas"></div>
            </div>

            <div class="db-grid-2">
                <div class="db-field">
                    <label for="f-dip">Dịp đặc biệt</label>
                    <div class="db-inp">
                        <select id="f-dip" class="form-select">
                            <option>Bữa ăn thân mật thông thường</option>
                            <option>Sinh nhật</option>
                            <option>Kỷ niệm ngày cưới</option>
                            <option>Cầu hôn</option>
                            <option>Họp mặt gia đình</option>
                            <option>Tiếp khách đối tác</option>
                        </select>
                    </div>
                </div>
                <div class="db-field">
                    <label for="f-note">Ghi chú yêu cầu riêng</label>
                    <div class="db-inp">
                        <input id="f-note" class="form-control" maxlength="500" placeholder="VD: dị ứng hải sản, cần ghế trẻ em..." />
                    </div>
                </div>
            </div>
        </div>

        <div class="db-card">
            <h2>
                <svg class="ic"><use href="#i-fork"/></svg>
                3. Chọn Món Trước
                <span class="h2-note">Không bắt buộc — giúp bếp chuẩn bị kịp thời</span>
            </h2>
            <div class="db-chips" id="cats"></div>
            <div id="menu"></div>
            <div id="cartBox" class="cartbox"></div>
        </div>

        <div class="d-flex justify-content-end mb-4">
            <button type="submit" class="btn-brand" id="btnNext">
                Tiếp theo: Đặt Cọc &amp; Thanh Toán
                <svg class="ic ms-2"><use href="#i-next"/></svg>
            </button>
        </div>
    </form>
</div>

{{/* ── BƯỚC 2 ── */}}
<div id="p2" class="panel" hidden>
    <button type="button" class="db-back" id="btnBack">
        <svg class="ic me-1"><use href="#i-left"/></svg> Quay lại chỉnh sửa thông tin
    </button>

    <div class="db-card">
        <h2><svg class="ic"><use href="#i-tag"/></svg> 1. Tổng Quan Chi Phí &amp; Mã Ưu Đãi</h2>
        <div class="db-promo">
            <input id="f-promo" class="form-control" maxlength="30" autocomplete="off" placeholder="NHẬP MÃ: AURAVIP hoặc WELCOME10" />
            <button type="button" class="btn-brand" id="btnPromo">Áp Dụng</button>
        </div>
        <div class="db-bill" id="bill"></div>
    </div>

    <div class="db-card">
        <h2><svg class="ic"><use href="#i-card"/></svg> 2. Chọn Chế Độ Đặt Cọc Giữ Bàn</h2>
        <div id="modes"></div>
        <div id="due"></div>
        <p class="db-note" id="holdNote"></p>
    </div>

    <div class="db-card">
        <h2><svg class="ic"><use href="#i-qr"/></svg> 3. Phương Thức Thanh Toán</h2>
        <div id="methods"></div>
        <div id="payPanel"></div>
        <p class="db-note">Môi trường thanh toán mô phỏng: hệ thống ghi nhận giao dịch khi bạn bấm xác nhận, chưa tự đối soát với ngân hàng / ví và không thu hay lưu thông tin thẻ.</p>
    </div>

    <div class="d-flex justify-content-between mb-4">
        <button type="button" class="btn-ghost-brand" id="btnBack2">← Quay lại Bước 1</button>
        <button type="button" class="btn-brand" id="btnConfirm"></button>
    </div>
</div>

{{/* ── BƯỚC 3 ── */}}
<div id="p3" class="panel" hidden>
    <section class="db-card done" id="done"></section>
</div>

<div id="toast" class="toast" role="alert"></div>

@section Scripts {
    <script>
        window.AURA = {
            areas:  @Json.Serialize(Model.KhuVucs.Select(k => new { k.Id, k.Ten, k.MoTa, k.PhuThu, k.SucChua })),
            mons:   @Json.Serialize(Model.Mons.Select(m => new { m.Id, m.Ten, m.MoTa, m.Gia, m.DanhMuc, m.HinhAnh, m.Emoji })),
            slots:  @Json.Serialize(Model.Slots),
            banks:  @Json.Serialize(Model.Banks),
            user:   @Json.Serialize(new { auth = Model.DaDangNhap, name = Model.HoTen, phone = Model.SoDienThoai, email = Model.Email }),
            rules:  @Json.Serialize(new { cocCoDinh = DatBanService.CocCoDinh, ty30 = DatBanService.TyLeCoc30, vat = DatBanService.TyLeVat, phiPhucVu = DatBanService.TyLePhucVu, khachToiDa = DatBanService.KhachToiDa, giuCho = DatBanService.ThoiGianGiuCho })
        };
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="~/js/aura-datban.js" asp-append-version="true"></script>
}
