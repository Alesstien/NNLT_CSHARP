@using QLNH_Web.Models
@model QLNH_Web.Models.DatBan
@{
    ViewData["Title"] = "Đặt cọc thành công";

    string BadgeClass(string tt) => tt switch
    {
        "Đã xác nhận" => "bg-success",
        "Đang chế biến" => "bg-primary",
        "Đã hoàn thành" or "Hoàn thành" or "Đã thanh toán" => "bg-info text-dark",
        "Đã hủy" => "bg-danger",
        _ => "bg-warning text-dark"
    };

    string MoTaTrangThai(string tt) => tt switch
    {
        "Đã xác nhận" => "Nhà hàng đã xác nhận đơn đặt bàn của bạn. Vui lòng đến đúng giờ hẹn.",
        "Đang chế biến" => "Nhà hàng đang chuẩn bị món ăn phục vụ bàn của bạn.",
        "Đã hoàn thành" or "Hoàn thành" or "Đã thanh toán" => "Đơn đặt bàn đã hoàn tất và thanh toán. Cảm ơn quý khách!",
        "Đã hủy" => "Đơn đặt bàn này đã bị hủy.",
        _ => "Nhà hàng sẽ đối chiếu khoản cọc và xác nhận với bạn sớm nhất."
    };
}

<div class="card mx-auto success-card"
     data-booking-status-id="@Model.Id"
     data-booking-initial-status="@Model.TrangThai">
    <div class="card-body">
        <p class="text-success fw-semibold mb-1" id="success-header">Đã nhận thông tin đặt cọc</p>
        <p class="small text-secondary mb-3">
            Trạng thái:
            <span id="status-badge" class="badge @BadgeClass(Model.TrangThai)">@Model.TrangThai</span>
            - <span id="status-desc">@MoTaTrangThai(Model.TrangThai)</span>
        </p>
        <div class="display-6 fw-bold mb-3 booking-code-display">@Model.MaDatBan</div>

        <dl class="row small mb-3">
            <dt class="col-4 fw-normal text-secondary">Khách</dt>
            <dd class="col-8">@Model.HoTen · @Model.SoDienThoai</dd>
            <dt class="col-4 fw-normal text-secondary">Thời gian</dt>
            <dd class="col-8">@Model.NgayGio.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-4 fw-normal text-secondary">Khu vực</dt>
            <dd class="col-8">@Model.KhuVuc?.Ten</dd>
            <dt class="col-4 fw-normal text-secondary">Số khách</dt>
            <dd class="col-8">@Model.SoKhach@(Model.SoBan > 1 ? " (" + Model.SoBan + " bàn)" : "") · @Model.DipDacBiet</dd>
            <dt class="col-4 fw-normal text-secondary">Món đặt trước</dt>
            <dd class="col-8">
                @if (Model.Mons.Any())
                {
                    @foreach (var m in Model.Mons)
                    {
                        <div>@m.TenMon × @m.SoLuong</div>
                    }
                    @if (Model.SoBan > 1) { <div class="text-secondary">(× @Model.SoBan mâm)</div> }
                }
                else
                {
                    <span class="text-secondary">Chưa chọn món trước (gọi món tại nhà hàng)</span>
                }
            </dd>
            <dt class="col-4 fw-normal text-secondary">Tổng hóa đơn</dt>
            <dd class="col-8">@Model.TongHoaDon.ToString("N0") đ</dd>
            <dt class="col-4 fw-normal text-secondary">Đã thanh toán</dt>
            <dd class="col-8 fw-bold">@Model.TienCoc.ToString("N0") đ qua @Model.PhuongThucThanhToan</dd>
            <dt class="col-4 fw-normal text-secondary">Còn lại</dt>
            <dd class="col-8">@(Model.Mons.Any() ? Model.ConLai.ToString("N0") + " đ (trả tại nhà hàng)" : "Tính theo hóa đơn thực tế tại nhà hàng")</dd>
            <dt class="col-4 fw-normal text-secondary">Mã giao dịch</dt>
            <dd class="col-8">@Model.MaGiaoDich</dd>
        </dl>

        <div id="arrival-reminder"
             class="alert alert-warning small py-2 px-3 mb-3 @(Model.TrangThai is "Đang chờ duyệt" or "Đã xác nhận" ? "" : "d-none")">
            <strong>Vui lòng đến đúng giờ hẹn.</strong><br />
            Nếu quý khách chưa đến sau 15 phút kể từ giờ hẹn, hệ thống sẽ tự động hủy đơn đặt bàn.
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-danger" asp-controller="Home" asp-action="Index">Về trang chủ</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="btn btn-outline-secondary" asp-controller="Cart" asp-action="History">Lịch sử đặt bàn</a>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cart.js" asp-append-version="true"></script>
}
