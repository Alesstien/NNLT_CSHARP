@model CheckoutViewModel
@{ ViewData["Title"] = "Đặt món"; var lines = (List<CartLine>)ViewBag.Lines; }
<h3>Thông tin đặt món</h3>
<div class="row">
  <div class="col-md-6">
    <form asp-action="Checkout" method="post">
      <div asp-validation-summary="ModelOnly" class="text-danger"></div>
      <div class="mb-3"><label class="form-label">Họ tên</label><input asp-for="TenKhach" class="form-control" /><span asp-validation-for="TenKhach" class="text-danger"></span></div>
      <div class="mb-3"><label class="form-label">Số điện thoại</label><input asp-for="SoDienThoai" class="form-control" /><span asp-validation-for="SoDienThoai" class="text-danger"></span></div>
      <div class="mb-3"><label class="form-label">Ghi chú</label><textarea asp-for="GhiChu" class="form-control" rows="3"></textarea></div>
      <button class="btn btn-danger">Xác nhận đặt món</button>
    </form>
  </div>
  <div class="col-md-6">
    <h5>Đơn hàng của bạn</h5>
    <ul class="list-group">
      @foreach (var l in lines) { <li class="list-group-item d-flex justify-content-between">@l.SoLuong × @l.TenMon <span>@l.ThanhTien.ToString("N0")</span></li> }
      <li class="list-group-item d-flex justify-content-between fw-bold"><span>Tổng</span><span class="price">@lines.Sum(x => x.ThanhTien).ToString("N0") đ</span></li>
    </ul>
  </div>
</div>
