@model List<CartLine>
@{ ViewData["Title"] = "Giỏ hàng"; }
<h3>Giỏ hàng</h3>
@if (!Model.Any())
{
  <div class="alert alert-info">Giỏ hàng trống. <a asp-controller="Menu" asp-action="Index">Xem thực đơn</a></div>
}
else
{
  <div class="table-responsive"><table class="table align-middle">
    <thead><tr><th>Món</th><th class="text-end">Đơn giá</th><th style="width:200px">Số lượng</th><th class="text-end">Thành tiền</th><th></th></tr></thead>
    <tbody>
    @foreach (var l in Model)
    {
      <tr>
        <td>@l.TenMon</td><td class="text-end">@l.DonGia.ToString("N0")</td>
        <td><form asp-action="Update" method="post" class="d-flex gap-1">
              <input type="hidden" name="id" value="@l.MonAnId" />
              <input type="number" name="soLuong" value="@l.SoLuong" min="0" class="form-control form-control-sm" />
              <button class="btn btn-sm btn-outline-secondary">Cập nhật</button></form></td>
        <td class="text-end">@l.ThanhTien.ToString("N0")</td>
        <td><form asp-action="Remove" method="post"><input type="hidden" name="id" value="@l.MonAnId" /><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td>
      </tr>
    }
    </tbody>
    <tfoot><tr><th colspan="3" class="text-end">Tổng cộng</th><th class="text-end price">@Model.Sum(x => x.ThanhTien).ToString("N0") đ</th><th></th></tr></tfoot>
  </table></div>
  <a class="btn btn-danger" asp-action="Checkout">Đặt món</a>
}
