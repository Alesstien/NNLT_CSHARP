@model List<MonAn>
@{ ViewData["Title"] = "Trang chủ"; var dms = (List<DanhMuc>)ViewBag.DanhMucs; }
<div class="hero mb-4">
  <h1 class="display-5 fw-bold">Hương vị Việt - Đậm đà từng món</h1>
  <p class="lead">Đặt món trực tuyến hoặc đặt bàn trước để không phải chờ đợi.</p>
  <a class="btn btn-light fw-semibold" asp-controller="Menu" asp-action="Index">Xem thực đơn</a>
</div>
<h4 class="mb-3">Danh mục món ăn</h4>
<div class="row g-2 mb-4" id="home-dm-filter">
  <div class="col-6 col-md-4 col-lg-2">
    <button type="button" class="btn btn-danger w-100 dm-filter-btn active" data-dm="all" data-ten="Tất cả">
      Tất cả <span class="badge bg-light text-danger ms-1">@Model.Count</span>
    </button>
  </div>
  @foreach (var d in dms)
  {
    var count = d.MonAns.Count(m => m.ConPhucVu);
    <div class="col-6 col-md-4 col-lg-2">
      <button type="button" class="btn btn-outline-danger w-100 dm-filter-btn" data-dm="@d.Id" data-ten="@d.TenDanhMuc">
        @d.TenDanhMuc <span class="badge bg-danger ms-1">@count</span>
      </button>
    </div>
  }
</div>
<h4 class="mb-3" id="home-mon-title">Thực đơn món ăn (@Model.Count món)</h4>
<div class="row g-3" id="home-mon-grid">
  @foreach (var m in Model)
  {
    <div class="col-12 col-sm-6 col-lg-4 home-mon-item" data-dm="@m.DanhMucId">
      <partial name="_MonCard" model="m" />
    </div>
  }
</div>
<div id="home-mon-empty" class="alert alert-warning d-none mt-2">Chưa có món ăn nào trong danh mục này.</div>
