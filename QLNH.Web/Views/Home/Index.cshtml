@model List<MonAn>
@{ ViewData["Title"] = "Trang chủ"; var dms = (List<DanhMuc>)ViewBag.DanhMucs; }
<div class="hero mb-4">
  <h1 class="display-5 fw-bold">Hương vị Việt - Đậm đà từng món</h1>
  <p class="lead">Đặt món trực tuyến hoặc đặt bàn trước để không phải chờ đợi.</p>
  <a class="btn btn-light me-2" asp-controller="Menu" asp-action="Index">Xem thực đơn</a>
  <a class="btn btn-outline-light" asp-controller="Reservation" asp-action="Create">Đặt bàn ngay</a>
</div>
<h4 class="mb-3">Danh mục món ăn</h4>
<div class="row g-2 mb-4">
  @foreach (var d in dms)
  {
    <div class="col-6 col-md-4 col-lg-2">
      <a class="btn btn-outline-danger w-100" asp-controller="Menu" asp-action="Index" asp-route-danhMucId="@d.Id">@d.TenDanhMuc <span class="badge bg-danger">@d.MonAns.Count</span></a>
    </div>
  }
</div>
<h4 class="mb-3">Món nổi bật</h4>
<div class="row g-3">
  @foreach (var m in Model) { <div class="col-12 col-sm-6 col-lg-4"><partial name="_MonCard" model="m" /></div> }
</div>
