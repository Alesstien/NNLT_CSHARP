@using Microsoft.AspNetCore.Identity
@using QLNH_Web.Models
@inject UserManager<AppUser> UserManager

<ul class="navbar-nav">
@if (User.Identity?.IsAuthenticated == true)
{
    var u = await UserManager.GetUserAsync(User);
    <li class="nav-item"><span class="nav-link">Xin chào, @(u?.HoTen ?? User.Identity!.Name)</span></li>
    <li class="nav-item">
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            <button type="submit" class="btn btn-link nav-link">Đăng xuất</button>
        </form>
    </li>
}
else
{
    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Đăng ký</a></li>
}
</ul>
