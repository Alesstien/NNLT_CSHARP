@using Microsoft.AspNetCore.Identity
@using QLNH_Web.Models
@using Microsoft.EntityFrameworkCore
@inject UserManager<AppUser> UserManager
@inject QLNH_Web.Data.AuthDbContext Db

<div class="auth-box">
@if (User.Identity?.IsAuthenticated == true)
{
    var u = await UserManager.GetUserAsync(User);
    var ten = string.IsNullOrWhiteSpace(u?.HoTen) ? (User.Identity!.Name ?? "") : u!.HoTen;
    var chuCai = ten.Length > 0 ? ten.Substring(0, 1).ToUpper() : "?";
    <div class="auth-user-pill" title="Tài khoản đang đăng nhập">
        <span class="auth-avatar">@chuCai</span>
        <span>Xin chào, <b>@ten</b></span>
    </div>
    if (User.IsInRole("Admin"))
    {
        var choDuyet = await Db.DatBans.CountAsync(d => d.TrangThai == TrangThaiDatBan.ChoDuyet);
        <a class="auth-btn auth-admin" asp-controller="Admin" asp-action="Reservations">
            Quản trị
            @if (choDuyet > 0) { <span class="auth-badge">@choDuyet</span> }
        </a>
    }
    <form asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" class="auth-btn auth-login">Đăng xuất</button>
    </form>
}
else
{
    <a class="auth-btn auth-login" asp-controller="Account" asp-action="Login">
        <svg viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="m10 17 5-5-5-5"/><path d="M15 12H3"/></svg>
        Đăng nhập
    </a>
    <a class="auth-btn auth-register" asp-controller="Account" asp-action="Register">
        <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg>
        Đăng ký
    </a>
}
</div>
