<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - Nhà hàng Hương Việt</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-brand sticky-top">
  <div class="container">
    <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🍜 Hương Việt</a>
    <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Menu" asp-action="Index">Thực đơn</a></li>
        
      </ul>
      <form class="d-flex me-3" asp-controller="Menu" asp-action="Index" method="get">
        <input class="form-control form-control-sm me-2" name="q" placeholder="Tìm món ăn..." />
        <button class="btn btn-sm btn-light">Tìm kiếm</button>
      </form>
      <a id="cart-btn" class="btn btn-sm btn-outline-light" asp-controller="Cart" asp-action="Index">🛒 Giỏ hàng</a>
        <partial name="_LoginPartial" />
    </div>
  </div>
</nav>
<main class="container py-4">
  @if (TempData["Msg"] is string msg) { <div class="alert alert-success">@msg</div> }
  @RenderBody()
</main>
<footer class="text-center text-muted py-3 border-top">© 2026 Nhà hàng Hương Việt - Đồ án môn Ngôn ngữ lập trình C#</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/cart-fly.js"></script>
</body>
</html>
