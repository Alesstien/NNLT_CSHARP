<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - Nhà hàng Hương Việt</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
@{
  var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
  var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
  var cartCount = QLNH_Web.Models.CartHelper.Get(Context.Session).Values.Sum();
}
<nav class="navbar navbar-expand-lg navbar-dark bg-brand sticky-top hv-navbar">
  <div class="container">
    <a class="navbar-brand hv-brand" asp-controller="Home" asp-action="Index">
      <span class="hv-brand-icon">🍜</span>
      <span>Hương Việt</span>
    </a>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0 hv-nav-links">
        <li class="nav-item">
          <a class="nav-link @(ctrl == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Trang chủ</a>
        </li>
        <li class="nav-item">
          <a class="nav-link @(ctrl == "Menu" ? "active" : "")" asp-controller="Menu" asp-action="Index">Thực đơn</a>
        </li>
        @if (User.Identity?.IsAuthenticated == true)
        {
          <li class="nav-item">
            <a class="nav-link @(ctrl == "Cart" && (act == "History" || act == "Details") ? "active" : "")" asp-controller="Cart" asp-action="History">Lịch sử đặt bàn</a>
          </li>
        }
      </ul>

      <div class="hv-header-actions">
        <form class="hv-search-box" asp-controller="Menu" asp-action="Index" method="get">
          <input class="hv-search-input" name="q" value="@Context.Request.Query["q"]" placeholder="Tìm món ăn..." autocomplete="off" />
          <button type="submit" class="hv-search-btn" title="Tìm kiếm">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span>Tìm</span>
          </button>
        </form>

        <a id="cart-btn" class="hv-cart-btn" asp-controller="Cart" asp-action="Index">
          <span class="hv-cart-icon">🛒</span>
          <span>Giỏ hàng</span>
          @if (cartCount > 0)
          {
            <span class="cart-badge">@cartCount</span>
          }
        </a>

        <partial name="_LoginPartial" />
      </div>
    </div>
  </div>
</nav>
<main class="container py-4">
  @if (TempData["Msg"] is string msg) { <div class="alert alert-success">@msg</div> }
  @RenderBody()
</main>
<footer class="text-center text-muted py-3 border-top">© 2026 Nhà hàng Hương Việt - Đồ án môn Ngôn ngữ lập trình C#</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/cart-fly.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
