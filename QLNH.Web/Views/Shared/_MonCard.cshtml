@model QLNH.Data.Entities.MonAn

<div class="card h-100 shadow-sm">
    <img src="@(string.IsNullOrEmpty(Model?.HinhAnh) ? "/images/default.jpg" : Model.HinhAnh)" 
         class="card-img-top" 
         alt="@Model?.TenMon" 
         style="height: 180px; object-fit: cover;" />

    <div class="card-body d-flex flex-column">
        <h5 class="card-title">@Model?.TenMon</h5>
        <p class="card-text text-muted small">@Model?.MoTa</p>
        <div class="mt-auto d-flex justify-content-between align-items-center">
            <span class="text-danger fw-bold">@Model?.Gia.ToString("N0") đ</span>
            <button class="btn btn-sm btn-danger">+ Thêm</button>
        </div>
    </div>
</div>