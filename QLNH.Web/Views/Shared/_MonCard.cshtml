@model QLNH.Data.Entities.MonAn

<div class="card card-mon h-100 shadow-sm">
    <a asp-controller="Menu" asp-action="Details" asp-route-id="@Model?.Id" class="text-decoration-none">
        <img src="@(string.IsNullOrEmpty(Model?.HinhAnh) ? "/images/com-tam.jpg" : Model.HinhAnh)"
             data-fallback-src="/images/com-tam.jpg"
             class="card-img-top cart-item-img mon-card-img"
             alt="@Model?.TenMon" />
    </a>

    <div class="card-body d-flex flex-column">
        <h5 class="card-title">
            <a asp-controller="Menu" asp-action="Details" asp-route-id="@Model?.Id" class="text-decoration-none text-dark">
                @Model?.TenMon
            </a>
        </h5>

        <p class="card-text text-muted small">
            @Model?.MoTa
        </p>

        <div class="mt-auto d-flex justify-content-between align-items-center">
            <span class="text-danger fw-bold">
                @((Model?.Gia ?? 0).ToString("N0")) đ
            </span>

            <form asp-controller="Cart"
                  asp-action="Add"
                  method="post"
                  class="cart-add-form">
                <input type="hidden" name="id" value="@Model?.Id" />
                <input type="hidden" name="soLuong" value="1" />

                <button type="submit" class="btn btn-sm btn-danger">
                    + Thêm
                </button>
            </form>
        </div>
    </div>
</div>
