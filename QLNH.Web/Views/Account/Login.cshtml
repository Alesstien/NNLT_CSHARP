@model QLNH_Web.ViewModels.LoginVM
@{ ViewData["Title"] = "Đăng nhập"; }

<div class="container py-5" style="max-width:480px">
    <h2 class="mb-4 text-center">Đăng nhập</h2>
    <form asp-action="Login" method="post" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <div class="mb-3">
            <label asp-for="TaiKhoan" class="form-label"></label>
            <input asp-for="TaiKhoan" class="form-control" autocomplete="username" />
            <span asp-validation-for="TaiKhoan" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MatKhau" class="form-label"></label>
            <div class="position-relative">
                <input asp-for="MatKhau" class="form-control pe-5" autocomplete="current-password" />
                <button type="button" class="btn btn-link text-secondary position-absolute top-50 end-0 translate-middle-y text-decoration-none px-3"
                        onclick="togglePassword('MatKhau', this)" title="Hiện/ẩn mật khẩu" aria-label="Hiện hoặc ẩn mật khẩu">
                    <svg class="icon-eye d-none" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg class="icon-eye-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                        <line x1="3" y1="21" x2="21" y2="3"></line>
                    </svg>
                </button>
            </div>
            <span asp-validation-for="MatKhau" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="NhoDangNhap" class="form-check-input" />
            <label asp-for="NhoDangNhap" class="form-check-label"></label>
        </div>
        <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
        <p class="text-center mt-3">Chưa có tài khoản? <a asp-action="Register">Đăng ký</a></p>
    </form>
</div>

<style>
    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear {
        display: none;
    }
</style>
<script>
    function togglePassword(inputId, btn) {
        const input = document.getElementById(inputId);
        if (!input) return;
        const show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        btn.querySelector('.icon-eye').classList.toggle('d-none', !show);
        btn.querySelector('.icon-eye-off').classList.toggle('d-none', show);
    }
</script>
