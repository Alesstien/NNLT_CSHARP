@model MonAn
@{ ViewData["Title"] = Model.TenMon; var lq = (List<MonAn>)ViewBag.LienQuan; }
<nav aria-label="breadcrumb"><ol class="breadcrumb">
  <li class="breadcrumb-item"><a asp-controller="Menu" asp-action="Index">Thực đơn</a></li>
  <li class="breadcrumb-item active">@Model.TenMon</li></ol></nav>
<div class="card shadow-sm p-3 mb-4">
  <div class="row g-4 align-items-center">
    <div class="col-md-5">
      <img src="@(string.IsNullOrEmpty(Model.HinhAnh) ? "/images/com-tam.jpg" : Model.HinhAnh)"
           onerror="this.onerror=null;this.src='/images/com-tam.jpg';"
           class="img-fluid rounded cart-item-img w-100"
           alt="@Model.TenMon"
           style="max-height: 300px; object-fit: cover;" />
    </div>
    <div class="col-md-7">
      <h2>@Model.TenMon</h2>
      <span class="badge bg-secondary">@Model.DanhMuc?.TenDanhMuc</span>
      <p class="mt-3">@Model.MoTa</p>
      <p class="fs-3 price text-danger fw-bold">@Model.Gia.ToString("N0") đ</p>
      <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline cart-add-form">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="soLuong" value="1" />
        <button type="submit" class="btn btn-danger">+ Thêm vào giỏ hàng</button>
      </form>
    </div>
  </div>
</div>
@if (lq.Any())
{
  <h5 class="mt-5">Món cùng danh mục</h5>
  <div class="row g-3">@foreach (var m in lq) { m.DanhMuc = Model.DanhMuc; <div class="col-md-4"><partial name="_MonCard" model="m" /></div> }</div>
}
