@model MonAn
@{ ViewData["Title"] = Model.TenMon; var lq = (List<MonAn>)ViewBag.LienQuan; }
<nav aria-label="breadcrumb"><ol class="breadcrumb">
  <li class="breadcrumb-item"><a asp-controller="Menu" asp-action="Index">Thực đơn</a></li>
  <li class="breadcrumb-item active">@Model.TenMon</li></ol></nav>
<div class="row">
  <div class="col-md-8">
    <h2>@Model.TenMon</h2>
    <span class="badge bg-secondary">@Model.DanhMuc?.TenDanhMuc</span>
    <p class="mt-3">@Model.MoTa</p>
    <p class="fs-3 price">@Model.Gia.ToString("N0") đ</p>
  <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
    <!-- Truyền ID của món ăn -->
    <input type="hidden" name="id" value="@Model.Id" />
    <!-- Số lượng mặc định là 1 -->
    <input type="hidden" name="soLuong" value="1" />
    
    <!-- Nút bấm thêm vào giỏ -->
    <button type="submit" class="btn btn-danger btn-sm">+ Thêm</button>
</form>
  </div>
</div>
@if (lq.Any())
{
  <h5 class="mt-5">Món cùng danh mục</h5>
  <div class="row g-3">@foreach (var m in lq) { m.DanhMuc = Model.DanhMuc; <div class="col-md-4"><partial name="_MonCard" model="m" /></div> }</div>
}
